<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Crumb.Desktop.ViewModels"
        x:Class="Crumb.Desktop.MainWindow" x:DataType="vm:MainViewModel"
        Title="Crumb" Width="700" Height="440" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14" Spacing="14">
      <Border x:Name="DropZone" DragDrop.AllowDrop="True" Background="Transparent">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="88,*,8,Auto">
            <TextBlock Text="Input file:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding InputPath}" IsReadOnly="True"
                     PlaceholderText="Select a file or drop it here" AutomationProperties.Name="Input file path" />
            <Button Grid.Column="3" Content="Browse..." Click="ChooseVideo" IsEnabled="{Binding CanEdit}" />
          </Grid>
          <TextBlock Text="{Binding SourceDetails}" Margin="88,0,0,0" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Separator />

      <Grid ColumnDefinitions="88,Auto,8,Auto,*" RowDefinitions="Auto,8,Auto,8,Auto,Auto">
        <TextBlock Text="Max. size:" VerticalAlignment="Center" />
        <TextBox x:Name="LimitInput" Grid.Column="1" Width="100" Text="{Binding LimitMb, Mode=TwoWay}"
                 IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Maximum file size in megabytes" />
        <TextBlock Grid.Column="3" Text="MB" VerticalAlignment="Center" />
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5" Margin="16,0,0,0" IsEnabled="{Binding CanEdit}">
          <Button Content="8 MB" Tag="8" Click="ChoosePreset" />
          <Button Content="25 MB" Tag="25" Click="ChoosePreset" />
          <Button Content="50 MB" Tag="50" Click="ChoosePreset" />
          <Button Content="100 MB" Tag="100" Click="ChoosePreset" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Resolution:" VerticalAlignment="Center" />
        <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Width="150" SelectedIndex="{Binding ResolutionIndex, Mode=TwoWay}"
                  IsEnabled="{Binding CanEdit}">
          <ComboBoxItem Content="Original" />
          <ComboBoxItem Content="Up to 1080p" />
          <ComboBoxItem Content="Up to 720p" />
          <ComboBoxItem Content="Up to 480p" />
        </ComboBox>
        <CheckBox Grid.Row="2" Grid.Column="4" Margin="16,0,0,0" Content="Limit CPU use"
                  IsChecked="{Binding ReducedCpu, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                  ToolTip.Tip="Uses fewer threads. Compression may take longer." />
        <TextBlock Grid.Row="4" Grid.ColumnSpan="5" Text="{Binding CompressionHint}" FontSize="12" TextWrapping="Wrap" />
      </Grid>

      <Grid ColumnDefinitions="88,*,8,Auto">
        <TextBlock Text="Output file:" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding OutputPath, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Output file path" />
        <Button Grid.Column="3" Content="Browse..." Click="ChooseOutput" IsEnabled="{Binding CanEdit}" />
      </Grid>

      <Separator />

      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Status}" />
        <Grid ColumnDefinitions="*,Auto">
          <ProgressBar Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsIndeterminate}"
                       Minimum="0" Maximum="100" Height="16" ShowProgressText="False" />
          <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" />
        <Expander Header="Error details" IsVisible="{Binding HasErrorDetails}">
          <TextBox Text="{Binding ErrorDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" FontSize="11" />
        </Expander>
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="Crumb 0.1.0" FontSize="11" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Open original" Click="OpenOriginal" IsVisible="{Binding AlreadyFits}" IsEnabled="{Binding CanEdit}" />
        <Button Grid.Column="2" Content="Open output" Click="OpenResult" IsVisible="{Binding HasResult}" Margin="8,0,0,0" />
        <Button Grid.Column="2" Content="Cancel" Click="CancelJob" IsVisible="{Binding IsBusy}" Margin="8,0,0,0" />
        <Button x:Name="CompressButton" Grid.Column="3" Content="Compress" IsEnabled="{Binding CanCompress}" Click="CompressVideo" Margin="8,0,0,0" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
